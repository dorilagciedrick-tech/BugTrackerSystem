        private BugReport? GetSelectedReport()
        {
            return displayListBox.SelectedItem as BugReport;
        }

        private void RefreshDisplay()
        {
            displayListBox.Items.Clear();

            var list = viewComboBox.SelectedItem?.ToString();
            if (list == "Review Board")
            {
                displayListBox.Items.AddRange(manager.ReviewBoard.Cast<object>().ToArray());
            }
            else
            {
                displayListBox.Items.AddRange(manager.Backlog.Cast<object>().ToArray());
            }
        }

        // AI assistant handlers
        private void DisplayListBox_DoubleClick(object? sender, EventArgs e)
        {
            var selected = GetSelectedReport();
            if (selected == null)
            {
                AppendAiMessage("User", "Please select a bug first.");
                AppendAiMessage("AI", "Select a bug from the list and I'll recommend the first things to check based on severity.");
                return;
            }

            var response = GenerateAiResponse(string.Empty, selected);
            AppendAiMessage("User", selected.ToString());
            AppendAiMessage("AI", response);
        }

        private void AiSendButton_Click(object? sender, EventArgs e)
        {
            var query = aiInput.Text?.Trim();
            if (string.IsNullOrEmpty(query)) return;
            AppendAiMessage("User", query);
            var response = GenerateAiResponse(query, GetSelectedReport());
            AppendAiMessage("AI", response);
            aiInput.Clear();
        }

        private void AppendAiMessage(string sender, string message)
        {
            var time = DateTime.Now.ToString("HH:mm");
            aiChatHistory.AppendText($"[{time}] {sender}: {message}\r\n\r\n");
            aiChatHistory.SelectionStart = aiChatHistory.TextLength;
            aiChatHistory.ScrollToCaret();
        }

        private string GenerateAiResponse(string userQuery, BugReport? selected)
        {
            // Use selected summary as context if user didn't provide input
            var source = !string.IsNullOrWhiteSpace(userQuery) ? userQuery : selected?.Summary ?? string.Empty;

            if (string.IsNullOrWhiteSpace(source))
            {
                return "Please provide a short summary or select a bug. I will prioritize major issues (crash, data loss, security, outage) first and avoid creating tickets for trivial fixes.";
            }

            // Avoid repeating identical responses for repeated queries
            if (!string.IsNullOrWhiteSpace(lastUserQuery) && string.Equals(lastUserQuery, source, StringComparison.OrdinalIgnoreCase))
            {
                var followups = new[]
                {
                    "Following up: if that didn't help, collect logs and a full repro and share them here.",
                    "I see you asked the same. Try these extra steps: reproduce with clean profile, capture console and app logs, and attach screenshots.",
                    "Additional tip: check recent commits/deploys and whether feature flags changed recently."
                };
                lastAiResponse = followups[rng.Next(followups.Length)];
                return lastAiResponse;
            }

            lastUserQuery = source;

            var lower = source.ToLowerInvariant();
            var trivial = new[] { "typo", "misspell", "spelling", "format", "alignment", "cosmetic", "ui label", "label", "style" };
            var critical = new[] { "crash", "exception", "nullreference", "data loss", "corrupt", "security", "vulnerab", "outage", "panic", "fatal" };
            var perf = new[] { "slow", "lag", "timeout", "performance", "memory leak", "out of memory", "oom", "hang", "freeze" };
            var functional = new[] { "error", "fail", "incorrect", "wrong", "does not", "cannot", "can't", "unable" };

            string severity;
            string why;
            string steps;

            if (critical.Any(k => lower.Contains(k)))
            {
                severity = "CRITICAL";
                why = "Detected keywords indicating crashes, exceptions, data loss, security, or outage.";
                steps = "1) Stop or isolate affected system if live. 2) Collect logs, full stack traces, and reproducible steps. 3) Capture memory/process dump and request increased logging. 4) Create a high-priority ticket, notify on-call and stakeholders, and consider rollback mitigations.";
            }
            else if (perf.Any(k => lower.Contains(k)))
            {
                severity = "PERFORMANCE";
                why = "Symptoms point to slowness, timeouts, or resource exhaustion.";
                steps = "1) Reproduce with similar load; capture CPU/memory metrics. 2) Collect traces or profiler output. 3) Check recent deploys or config changes. 4) Apply mitigations (throttling, caching) while investigating.";
            }
            else if (trivial.Any(k => lower.Contains(k)))
            {
                severity = "TRIVIAL / UI";
                why = "Appears cosmetic or a small UI/text issue.";
                steps = "1) Verify reproduction and frequency. 2) Search for duplicates. 3) If confirmed, create a low-priority fix/PR with screenshots and close after merge.";
            }
            else if (functional.Any(k => lower.Contains(k)))
            {
                severity = "FUNCTIONAL";
                why = "General functional failures or incorrect behavior detected.";
                steps = "1) Attempt to reproduce with exact steps and inputs. 2) Gather logs and error messages. 3) Identify scope and affected users. 4) If impact is high, escalate; otherwise assign to dev with repro and tests.";
            }
            else
            {
                severity = "GENERAL";
                why = "No obvious critical keywords found; requires reproduction and impact assessment.";
                steps = "1) Reproduce and document exact steps. 2) Collect logs and environment details. 3) Search existing issues. 4) Determine impact (major vs minor) and prioritize accordingly.";
            }

            var header = selected != null ? $"Bug {selected.BugID} ({selected.DeveloperName}): " : string.Empty;

            var intros = new[]
            {
                "Here's what I suggest:",
                "Recommended next steps:",
                "Start with these actions:"
            };
            var outro = new[]
            {
                "If you need, paste logs here and I can help interpret them.",
                "When you have repro steps I can help suggest debugging commands or tests.",
                "I can help draft a concise ticket or checklist for this issue if you want."
            };

            var intro = intros[rng.Next(intros.Length)];
            var closing = outro[rng.Next(outro.Length)];

            lastAiResponse = $"{header}{severity} - {why}\r\n{intro} {steps} {closing}";
            return lastAiResponse;
        }

