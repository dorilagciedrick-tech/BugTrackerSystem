        private BugReport? GetSelectedReport()
        {
            return displayListBox.SelectedItem as BugReport;
        }

        private void RefreshDisplay()
        {
            displayListBox.Items.Clear();

            var list = viewComboBox.SelectedItem?.ToString();
            if (list == "Review Board")
            {
                displayListBox.Items.AddRange(manager.ReviewBoard.Cast<object>().ToArray());
            }
            else
            {
                displayListBox.Items.AddRange(manager.Backlog.Cast<object>().ToArray());
            }
        }

        // AI assistant handlers
        private void DisplayListBox_DoubleClick(object? sender, EventArgs e)
        {
            var selected = GetSelectedReport();
            if (selected == null)
            {
                AppendAiMessage("User", "Please select a bug first.");
                AppendAiMessage("AI", "Select a bug from the list and I'll recommend the first things to check based on severity.");
                return;
            }

            var recommendation = GenerateAiRecommendation(selected.Summary, selected);
            AppendAiMessage("User", selected.ToString());
            AppendAiMessage("AI", recommendation);
        }

        private void AiSendButton_Click(object? sender, EventArgs e)
        {
            var query = aiInput.Text?.Trim();
            if (string.IsNullOrEmpty(query)) return;
            AppendAiMessage("User", query);
            var recommendation = GenerateAiRecommendation(query, GetSelectedReport());
            AppendAiMessage("AI", recommendation);
            aiInput.Clear();
        }

        private void AppendAiMessage(string sender, string message)
        {
            var time = DateTime.Now.ToString("HH:mm");
            aiChatHistory.AppendText($"[{time}] {sender}: {message}\r\n\r\n");
            aiChatHistory.SelectionStart = aiChatHistory.TextLength;
            aiChatHistory.ScrollToCaret();
        }

        private string GenerateAiRecommendation(string text, BugReport? selected)
        {
            if (string.IsNullOrWhiteSpace(text) && selected == null)
            {
                return "Give me a short summary or select a bug. I will prioritize major issues (crash, data loss, security, outage) first and avoid creating tickets for trivial fixes.";
            }

            var lower = (text ?? string.Empty).ToLowerInvariant();

            // Trivial / cosmetic quick-fix keywords
            var trivial = new[] { "typo", "misspell", "spelling", "format", "alignment", "cosmetic", "ui label", "UI label" };
            if (trivial.Any(k => lower.Contains(k)))
            {
                return "This looks cosmetic or a simple typo: check if it's reproducible, search existing issues, and if confirmed apply a small PR and close the report. Do not escalate unless user impact exists.";
            }

            // Critical keywords
            var critical = new[] { "crash", "exception", "nullreference", "data loss", "corrupt", "security", "vulnerab", "outage", "panic", "fatal" };
            if (critical.Any(k => lower.Contains(k)))
            {
                return "HIGH PRIORITY: Possible critical issue. First steps: 1) Stop further production actions if customers are impacted. 2) Collect logs, exception stack traces, and repro steps. 3) Capture dump or traces and increase logging. 4) Create a high-priority ticket and notify stakeholders. 5) If possible, roll back recent deploys to mitigate impact.";
            }

            var perf = new[] { "slow", "lag", "timeout", "performance", "memory leak", "out of memory", "oom", "hang", "freeze" };
            if (perf.Any(k => lower.Contains(k)))
            {
                return "PERFORMANCE: Reproduce under similar conditions, gather metrics (CPU, memory), collect traces/profiler output, check recent changes, and consider throttling or rate-limiting while investigating.";
            }

            // Default prioritization guidance
            return "Suggested first steps (prioritize major impact): 1) Attempt to reproduce and document exact steps. 2) Check logs and error messages; copy stack trace. 3) Search existing issues for duplicates. 4) Determine user impact (data loss, security, outage vs cosmetic). 5) If major, collect traces and escalate; if minor, tag as low priority and assign for a small fix.";
        }

        private void ClearInputs()
