using System;
using System.IO;
using System.Net.Http;
using System.Text;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;

// Minimal modern .NET 8 console app that posts a chat prompt to a local Ollama server
// and prints the model response. Supports streaming (SSE/NDJSON-style) reading when available
// and falls back to a non-streaming JSON response parse.

const string DefaultEndpoint = "http://localhost:11434/api/chat"; // user requested base

using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(60) };

async Task<int> MainAsync(string[] args)
{
    Console.OutputEncoding = Encoding.UTF8;

    var endpoint = args.Length > 0 ? args[0] : DefaultEndpoint;
    var model = args.Length > 1 ? args[1] : "llama3.2";
    var token = args.Length > 2 ? args[2] : "ollama"; // default token as requested
    var useStreaming = true; // try streaming by default; you can change this flag

    Console.WriteLine("Ollama Chat Console (connecting to: " + endpoint + ")");
    Console.WriteLine("Model: " + model);
    Console.WriteLine();

    // Example messages (chat format)
    var messages = new[]
    {
        new { role = "system", content = "You are a helpful assistant that prioritizes troubleshooting steps for bugs." },
        new { role = "user", content = "Application crashes on save with NullReferenceException. What should I check first?" }
    };

    try
    {
        if (useStreaming)
        {
            Console.WriteLine("[Streaming mode] Sending request...");
            await SendStreamingChatAsync(http, endpoint, model, token, messages, CancellationToken.None);
        }
        else
        {
            Console.WriteLine("[Non-streaming mode] Sending request...");
            var reply = await SendChatAsync(http, endpoint, model, token, messages, CancellationToken.None);
            Console.WriteLine();
            Console.WriteLine("Model reply:\n" + reply);
        }

        return 0;
    }
    catch (Exception ex)
    {
        Console.WriteLine();
        Console.WriteLine("Error: " + ex.Message);
        return 1;
    }
}

// Non-streaming: POST JSON and parse response
static async Task<string> SendChatAsync(HttpClient http, string endpoint, string model, string token, object[] messages, CancellationToken ct)
{
    using var req = new HttpRequestMessage(HttpMethod.Post, endpoint);
    var payload = new { model, messages };
    var json = JsonSerializer.Serialize(payload);
    req.Content = new StringContent(json, Encoding.UTF8, "application/json");
    if (!string.IsNullOrWhiteSpace(token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

    using var resp = await http.SendAsync(req, ct).ConfigureAwait(false);
    var body = await resp.Content.ReadAsStringAsync(ct).ConfigureAwait(false);
    if (!resp.IsSuccessStatusCode)
        throw new InvalidOperationException($"Server returned {(int)resp.StatusCode}: {body}");

    // Try to extract the typical fields from common LLM responses
    try
    {
        using var doc = JsonDocument.Parse(body);
        var root = doc.RootElement;

        if (TryExtractModelText(root, out var text)) return text;

        // Fallback: return formatted JSON
        return root.ToString();
    }
    catch (JsonException)
    {
        // Not JSON; return raw
        return body;
    }
}

// Streaming: read response body as stream and process SSE/NDJSON lines
static async Task SendStreamingChatAsync(HttpClient http, string endpoint, string model, string token, object[] messages, CancellationToken ct)
{
    using var req = new HttpRequestMessage(HttpMethod.Post, endpoint);

    // Many Ollama wrappers accept { model, messages } (or { model, prompt } for some). Here use model + messages.
    var payload = new { model, messages, stream = true };
    var json = JsonSerializer.Serialize(payload);
    req.Content = new StringContent(json, Encoding.UTF8, "application/json");

    if (!string.IsNullOrWhiteSpace(token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

    // Ask HttpClient to return once headers are read so we can stream the content
    using var resp = await http.SendAsync(req, HttpCompletionOption.ResponseHeadersRead, ct).ConfigureAwait(false);
    resp.EnsureSuccessStatusCode();

    await using var stream = await resp.Content.ReadAsStreamAsync(ct).ConfigureAwait(false);
    using var reader = new StreamReader(stream, Encoding.UTF8);

    Console.WriteLine();
    Console.Write("Model reply: ");
    var buffer = new StringBuilder();

    while (!reader.EndOfStream)
    {
        var line = await reader.ReadLineAsync().ConfigureAwait(false);
        if (line == null) break;

        line = line.Trim();
        if (line.Length == 0) continue;

        // Handle SSE-style lines that begin with 'data: '
        if (line.StartsWith("data: ", StringComparison.OrdinalIgnoreCase))
        {
            var payloadLine = line.Substring("data: ".Length);
            if (payloadLine == "[DONE]") break;
            ProcessStreamingJsonChunk(payloadLine, buffer);
            continue;
        }

        // Handle raw JSON chunks or NDJSON
        try
        {
            ProcessStreamingJsonChunk(line, buffer);
        }
        catch
        {
            // Not JSON, print raw
            Console.Write(line);
        }
    }

    Console.WriteLine();
    Console.WriteLine();
}

static void ProcessStreamingJsonChunk(string jsonLine, StringBuilder buffer)
{
    try
    {
        using var doc = JsonDocument.Parse(jsonLine);
        var root = doc.RootElement;

        if (TryExtractModelText(root, out var text))
        {
            Console.Write(text);
            buffer.Append(text);
            return;
        }

        // Some streaming APIs use { "delta": { "content": "..." } }
        if (root.TryGetProperty("delta", out var delta) && delta.ValueKind == JsonValueKind.Object)
        {
            if (delta.TryGetProperty("content", out var contentEl) && contentEl.ValueKind == JsonValueKind.String)
            {
                var part = contentEl.GetString() ?? string.Empty;
                Console.Write(part);
                buffer.Append(part);
                return;
            }
        }

        // Generic fallback: if it's a simple string
        if (root.ValueKind == JsonValueKind.String)
        {
            var s = root.GetString();
            if (!string.IsNullOrEmpty(s))
            {
                Console.Write(s);
                buffer.Append(s);
            }
        }
    }
    catch (JsonException)
    {
        // ignore parse errors for chunks
    }
}

// Attempt to extract human-readable text from various JSON shapes
static bool TryExtractModelText(JsonElement root, out string text)
{
    text = string.Empty;

    // Common shapes:
    // { "response": "..." }
    if (root.TryGetProperty("response", out var responseEl) && responseEl.ValueKind == JsonValueKind.String)
    {
        text = responseEl.GetString() ?? string.Empty;
        return true;
    }

    // { "generated_text": "..." }
    if (root.TryGetProperty("generated_text", out var gen) && gen.ValueKind == JsonValueKind.String)
    {
        text = gen.GetString() ?? string.Empty;
        return true;
    }

    // { "choices": [ { "message": { "content": "..." } } ] }
    if (root.TryGetProperty("choices", out var choices) && choices.ValueKind == JsonValueKind.Array && choices.GetArrayLength() > 0)
    {
        var first = choices[0];
        if (first.TryGetProperty("message", out var message) && message.ValueKind == JsonValueKind.Object)
        {
            if (message.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.String)
            {
                text = content.GetString() ?? string.Empty;
                return true;
            }
        }

        if (first.TryGetProperty("text", out var textEl) && textEl.ValueKind == JsonValueKind.String)
        {
            text = textEl.GetString() ?? string.Empty;
            return true;
        }
    }

    // { "choices": [ { "delta": { "content": "..." } } ] }
    if (root.TryGetProperty("choices", out var ch) && ch.ValueKind == JsonValueKind.Array && ch.GetArrayLength() > 0)
    {
        var c0 = ch[0];
        if (c0.TryGetProperty("delta", out var delta) && delta.ValueKind == JsonValueKind.Object)
        {
            if (delta.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.String)
            {
                text = content.GetString() ?? string.Empty;
                return true;
            }
        }
    }

    // { "outputs": [ { "content": "..." } ] }
    if (root.TryGetProperty("outputs", out var outputs) && outputs.ValueKind == JsonValueKind.Array && outputs.GetArrayLength() > 0)
    {
        var out0 = outputs[0];
        if (out0.TryGetProperty("content", out var c) && c.ValueKind == JsonValueKind.String)
        {
            text = c.GetString() ?? string.Empty;
            return true;
        }
    }

    // { "message": { "content": "..." } }
    if (root.TryGetProperty("message", out var message2) && message2.ValueKind == JsonValueKind.Object)
    {
        if (message2.TryGetProperty("content", out var c2) && c2.ValueKind == JsonValueKind.String)
        {
            text = c2.GetString() ?? string.Empty;
            return true;
        }
    }

    return false;
}

// Entry point for top-level statements compatibility
return await MainAsync(args);