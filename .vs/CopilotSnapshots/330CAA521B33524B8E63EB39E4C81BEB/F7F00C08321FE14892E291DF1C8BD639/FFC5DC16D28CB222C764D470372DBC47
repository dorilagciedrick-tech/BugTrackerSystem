        public OllamaClient(HttpClient? httpClient = null, string? endpoint = null)
        {
            _endpoint = string.IsNullOrWhiteSpace(endpoint) ? "http://localhost:11434/api/chat" : endpoint!;
            if (httpClient is null)
            {
                _http = new HttpClient();
                _disposeHttp = true;
            }
            else
            {
                _http = httpClient;
                _disposeHttp = false;
            }
        }

