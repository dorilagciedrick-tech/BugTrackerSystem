        private void RefreshDisplay()
        {
            displayListBox.Items.Clear();

            var list = viewComboBox.SelectedItem?.ToString();
            if (list == "Review Board")
            {
                displayListBox.Items.AddRange(manager.ReviewBoard.Cast<object>().ToArray());
            }
            else
            {
                displayListBox.Items.AddRange(manager.Backlog.Cast<object>().ToArray());
            }
        }

        // AI assistant handlers
        private async void DisplayListBox_DoubleClick(object? sender, EventArgs e)
        {
            var selected = GetSelectedReport();
            if (selected == null)
            {
                AppendAiMessage("User", "Please select a bug first.");
                AppendAiMessage("AI", "Select a bug from the list and I'll recommend the first things to check based on severity.");
                return;
            }

            AppendAiMessage("User", selected.ToString());
            // show temporary thinking indicator
            AppendAiThinking();
            try
            {
                var prompt = BuildPrompt(string.Empty, selected);
                var response = await CallTextGenerationInferenceAsync(prompt) ?? LocalFallbackResponse(selected?.Summary ?? string.Empty);
                ReplaceAiThinkingWith(response);
            }
            catch (Exception ex)
            {
                ReplaceAiThinkingWith($"Error calling model: {ex.Message}");
            }
        }

        private async void AiSendButton_Click(object? sender, EventArgs e)
        {
            var query = aiInput.Text?.Trim();
            if (string.IsNullOrEmpty(query)) return;
            AppendAiMessage("User", query);

            AppendAiThinking();
            try
            {
                var prompt = BuildPrompt(query, GetSelectedReport());
                var response = await CallTextGenerationInferenceAsync(prompt) ?? LocalFallbackResponse(query);
                // no-op refresh to ensure compile/context updates in some IDEs
                RefreshDisplay();
                ReplaceAiThinkingWith(response);
            }
            catch (Exception ex)
            {
                ReplaceAiThinkingWith($"Error calling model: {ex.Message}");
            }

            aiInput.Clear();
        }

        private void AppendAiMessage(string sender, string message)
        {
            var time = DateTime.Now.ToString("HH:mm");
            aiChatHistory.AppendText($"[{time}] {sender}: {message}\r\n\r\n");
            aiChatHistory.SelectionStart = aiChatHistory.TextLength;
            aiChatHistory.ScrollToCaret();
        }

        private void AppendAiThinking()
        {
            var time = DateTime.Now.ToString("HH:mm");
            thinkingIndex = aiChatHistory.TextLength;
            aiChatHistory.AppendText($"[{time}] AI: Thinking...\r\n\r\n");
            aiChatHistory.SelectionStart = aiChatHistory.TextLength;
            aiChatHistory.ScrollToCaret();
        }

        private void ReplaceAiThinkingWith(string message)
        {
            try
            {
                var time = DateTime.Now.ToString("HH:mm");
                var newText = $"[{time}] AI: {message}\r\n\r\n";
                if (thinkingIndex >= 0 && thinkingIndex <= aiChatHistory.TextLength)
                {
                    aiChatHistory.Text = aiChatHistory.Text.Substring(0, thinkingIndex) + newText;
                }
                else
                {
                    aiChatHistory.AppendText(newText);
                }

                aiChatHistory.SelectionStart = aiChatHistory.TextLength;
                aiChatHistory.ScrollToCaret();
            }
            finally
            {
                thinkingIndex = -1;
            }
        }

