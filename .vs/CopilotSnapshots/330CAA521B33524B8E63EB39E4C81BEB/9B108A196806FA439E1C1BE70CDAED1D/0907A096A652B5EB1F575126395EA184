        private static void ConfigureButton(Button button, string text, int left, int top, int width, int height, Color backColor, Color hoverColor)
        {
            button.Text = text;
            button.SetBounds(left, top, width, height);
            button.FlatStyle = FlatStyle.Flat;
            button.FlatAppearance.BorderSize = 0;
            button.ForeColor = Color.White;
            button.Font = new Font("Segoe UI", 10F, FontStyle.Bold, GraphicsUnit.Point);
            button.BackColor = backColor;
            button.Cursor = Cursors.Hand;
            button.MouseEnter += (_, _) => button.BackColor = hoverColor;
            button.MouseLeave += (_, _) => button.BackColor = backColor;
        }

        private void SubmitButton_Click(object? sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(developerTextBox.Text) || string.IsNullOrWhiteSpace(bugIdTextBox.Text))
            {
                MessageBox.Show("Please enter both Developer name and Bug ID before submitting.", "Missing Data", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var report = new BugReport(developerTextBox.Text.Trim(), bugIdTextBox.Text.Trim(), summaryTextBox.Text.Trim());
            manager.SubmitBug(report);
            ClearInputs();
            RefreshDisplay();
        }

