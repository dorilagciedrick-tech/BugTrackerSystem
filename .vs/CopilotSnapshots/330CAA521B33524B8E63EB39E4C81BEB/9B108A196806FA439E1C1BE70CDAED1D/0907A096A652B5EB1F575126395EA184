        private string LocalFallbackResponse(string context)
        {
            if (string.IsNullOrWhiteSpace(context))
            {
                return "Local LLM did not respond. Ensure a Text Generation Inference server is running at the configured endpoint (default: http://127.0.0.1:8080/v1/generate).";
            }

            return "Local LLM did not respond. Try reproducing the issue, collecting logs and stack traces, and then retry. If you want, change the endpoint to a different local model server.";
        }

        private string BuildPrompt(string userQuery, BugReport? selected)
        {
            var sb = new StringBuilder();
            sb.AppendLine("You are an assistant that recommends the first actions a developer or support engineer should take when they encounter a bug. Prioritize only necessary and high-impact steps. Keep responses concise.");
            if (selected != null)
            {
                sb.AppendLine($"Selected bug: ID={selected.BugID}, Developer={selected.DeveloperName}, Summary={selected.Summary}");
            }
            if (!string.IsNullOrWhiteSpace(userQuery))
            {
                sb.AppendLine("User query:");
                sb.AppendLine(userQuery);
            }
            sb.AppendLine();
            sb.AppendLine("Respond with a short prioritized list (1-5) and a one-sentence reason.");
            return sb.ToString();
        }

        private async Task<string?> CallTextGenerationInferenceAsync(string prompt)
        {
            try
            {
                var endpoint = llmEndpointTextBox.Text?.Trim();
                if (string.IsNullOrWhiteSpace(endpoint))
                {
                    return "LLM endpoint is not configured. Please run a local Text Generation Inference server and set its generate URL in the endpoint field.";
                }

                var uri = endpoint;
                var provider = llmProviderComboBox.SelectedItem?.ToString() ?? string.Empty;
                object payload;
                var model = modelNameTextBox.Text?.Trim();
                if (provider != null && provider.Contains("Llama", StringComparison.OrdinalIgnoreCase))
                {
                    // Ollama expects { model, prompt } shape for many wrappers; use model from UI
                    if (!string.IsNullOrWhiteSpace(model))
                    {
                        payload = new { model = model, prompt = prompt };
                    }
                    else
                    {
                        payload = new { model = "llama3.2", prompt = prompt };
                    }
                }
                else
                {
                    payload = new { inputs = prompt, parameters = new { max_new_tokens = 256, temperature = 0.2 } };
                }
                var json = JsonSerializer.Serialize(payload);
                using var req = new HttpRequestMessage(HttpMethod.Post, uri)
                {
                    Content = new StringContent(json, Encoding.UTF8, "application/json")
                };

                // Attach API token from UI if present
                var token = apiTokenTextBox.Text?.Trim();
                if (!string.IsNullOrWhiteSpace(token))
                {
                    try
                    {
                        req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                    }
                    catch { }
                }

                using var cts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(20));
                var resp = await httpClient.SendAsync(req, cts.Token).ConfigureAwait(false);
                var respText = await resp.Content.ReadAsStringAsync(cts.Token).ConfigureAwait(false);

                if (!resp.IsSuccessStatusCode)
                {
                    return $"Local LLM request failed ({(int)resp.StatusCode}). Response: {respText}";
                }

                try
                {
                    using var doc = JsonDocument.Parse(respText);
                    var root = doc.RootElement;

                    // Text Generation Inference commonly returns 'generated_text' or 'results'[0]['text']
                    if (root.TryGetProperty("generated_text", out var gen)) return gen.GetString();
                    if (root.TryGetProperty("results", out var results) && results.ValueKind == JsonValueKind.Array && results.GetArrayLength() > 0)
                    {
                        var first = results[0];
                        if (first.TryGetProperty("text", out var t)) return t.GetString();
                        if (first.TryGetProperty("generated_text", out var gt)) return gt.GetString();
                    }

                    // Some servers return array of strings
                    if (root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0)
                    {
                        var first = root[0];
                        if (first.ValueKind == JsonValueKind.Object && first.TryGetProperty("generated_text", out var g2)) return g2.GetString();
                        if (first.ValueKind == JsonValueKind.String) return first.GetString();
                    }

                    // fallback: return raw body
                    return respText;
                }
                catch (JsonException)
                {
                    return respText;
                }
            }
            catch (Exception ex)
            {
                return $"Local LLM call failed: {ex.Message}.";
            }
        }

